---
import { listVisibleProducts } from "../lib/db";
import { groupProductsByFamily } from "../lib/product-families";

const products = listVisibleProducts();
const families = groupProductsByFamily(products);
const familiesJson = JSON.stringify(families);
---

<section
  id="subscribe"
  class="shop"
  data-testid="subscribe-shop"
  data-families={familiesJson}
>
  {
    families.length === 0 ? (
      <p class="empty" data-testid="catalog-empty">
        暂无可购会员，请稍后再来。
      </p>
    ) : (
      <div class="family-grid">
        {families.map((f, i) => (
          <button
            type="button"
            class:list={["family-card", { selected: i === 0 }]}
            data-family-id={f.id}
            data-testid={`family-${f.id}`}
            aria-pressed={i === 0 ? "true" : "false"}
            aria-label={`${f.vendor} ${f.productLabel}`}
          >
            <span class="family-icon" aria-hidden="true" data-icon={f.id}>
              {f.id === "chatgpt" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                  <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.908 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.774-4.238 5.99 5.99 0 0 0 3.997-2.908 6.056 6.056 0 0 0-.747-7.033zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023-.141-.085-4.784-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135 2.02-1.163v-2.34l-2.02 1.163v2.34z" />
                </svg>
              )}
              {f.id === "claude" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                  <path d="M4.714 15.956 12 3.6l7.286 12.356H4.714Zm1.97-.98h10.632L12 6.57 6.684 14.976Zm-2.84 2.348h15.312v1.676H3.844v-1.676Z" />
                </svg>
              )}
              {f.id === "grok" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                  <path d="M6.2 3.5h3.1L18.4 20.5h-3.2L6.2 3.5Zm8.5 0h3.1L12 12.1l-1.7-3.1L14.7 3.5ZM5.6 20.5 9.2 14l1.7 3.1-3.7 3.4H5.6Z" />
                </svg>
              )}
              {f.id === "gemini" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                  <path d="M12 2.2c.4 3.9 3.9 7.4 7.8 7.8-3.9.4-7.4 3.9-7.8 7.8-.4-3.9-3.9-7.4-7.8-7.8 3.9-.4 7.4-3.9 7.8-7.8Z" />
                </svg>
              )}
            </span>
            <span class="family-vendor">{f.vendor}</span>
            <span class="family-name">{f.productLabel}</span>
            <span class="family-price">
              从 <strong>¥{f.fromPrice}</strong> /月 起
            </span>
          </button>
        ))}
      </div>
    )
  }
</section>

<aside
  class="checkout-bar"
  data-testid="checkout-bar"
  data-visible={families.length > 0 ? "true" : "false"}
  hidden={families.length === 0}
>
  <div class="checkout-inner">
    <div class="checkout-info">
      <p class="checkout-title" data-testid="checkout-title">—</p>
      <p class="checkout-hint">自动发送原号开通凭证至邮箱 · 支持 USDT 结算</p>
      <div class="plan-pills" data-testid="plan-pills" role="group" aria-label="选择套餐"></div>
    </div>
    <form class="checkout-form" id="checkout-form" data-testid="checkout-form">
      <label class="sr-only" for="checkout-email">邮箱</label>
      <input
        id="checkout-email"
        type="email"
        name="email"
        required
        placeholder="you@example.com"
        autocomplete="email"
        data-testid="checkout-email"
      />
      <p class="checkout-error" id="checkout-error" hidden data-testid="checkout-error"></p>
      <button type="submit" class="btn btn-primary checkout-submit" data-testid="checkout-submit">
        继续
      </button>
    </form>
  </div>
</aside>

<script>
  type FamilyPlan = {
    id: number;
    slug: string;
    name: string;
    priceCny: number;
    planLabel: string;
    periodHint: string;
  };

  type ProductFamily = {
    id: string;
    vendor: string;
    productLabel: string;
    fromPrice: number;
    plans: FamilyPlan[];
  };

  const shop = document.querySelector<HTMLElement>("[data-testid='subscribe-shop']");
  const bar = document.querySelector<HTMLElement>("[data-testid='checkout-bar']");
  if (!shop || !bar) throw new Error("subscribe shop missing");

  const families = JSON.parse(shop.dataset.families || "[]") as ProductFamily[];
  if (families.length === 0) {
    /* empty catalog */
  } else {
    let selectedFamilyId = families[0].id;
    let selectedProductId = families[0].plans[0]?.id ?? 0;

    const titleEl = bar.querySelector<HTMLElement>("[data-testid='checkout-title']");
    const pillsEl = bar.querySelector<HTMLElement>("[data-testid='plan-pills']");
    const form = bar.querySelector<HTMLFormElement>("#checkout-form");
    const errorEl = bar.querySelector<HTMLElement>("#checkout-error");
    const cards = Array.from(
      shop.querySelectorAll<HTMLButtonElement>("[data-family-id]"),
    );

    function currentFamily() {
      return families.find((f) => f.id === selectedFamilyId) ?? families[0];
    }

    function currentPlan() {
      const family = currentFamily();
      return family.plans.find((p) => p.id === selectedProductId) ?? family.plans[0];
    }

    function renderCheckout() {
      const family = currentFamily();
      const plan = currentPlan();
      if (!titleEl || !pillsEl || !plan) return;

      titleEl.textContent = `${family.productLabel} ${plan.planLabel} · RMB ${plan.priceCny} ${plan.periodHint}`;

      pillsEl.innerHTML = "";
      for (const p of family.plans) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "plan-pill" + (p.id === plan.id ? " active" : "");
        btn.textContent = p.planLabel;
        btn.dataset.productId = String(p.id);
        btn.dataset.testid = `plan-${p.slug}`;
        btn.setAttribute("aria-pressed", p.id === plan.id ? "true" : "false");
        btn.addEventListener("click", () => {
          selectedProductId = p.id;
          renderCheckout();
        });
        pillsEl.appendChild(btn);
      }
    }

    function selectFamily(id: string) {
      selectedFamilyId = id;
      const family = currentFamily();
      selectedProductId = family.plans[0]?.id ?? 0;
      for (const card of cards) {
        const on = card.dataset.familyId === id;
        card.classList.toggle("selected", on);
        card.setAttribute("aria-pressed", on ? "true" : "false");
      }
      renderCheckout();
    }

    for (const card of cards) {
      card.addEventListener("click", () => {
        const id = card.dataset.familyId;
        if (id) selectFamily(id);
      });
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form || !errorEl) return;
      errorEl.hidden = true;
      const email = (form.elements.namedItem("email") as HTMLInputElement).value.trim();
      const plan = currentPlan();
      if (!plan) return;
      const btn = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (btn) {
        btn.disabled = true;
        btn.textContent = "创建中…";
      }
      try {
        const res = await fetch("/api/orders", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ productId: plan.id, email }),
        });
        const data = await res.json();
        if (!res.ok) {
          errorEl.textContent = data.error || "下单失败";
          errorEl.hidden = false;
          return;
        }
        location.href = `/pay/${data.orderNo}`;
      } catch {
        errorEl.textContent = "网络异常，请稍后重试";
        errorEl.hidden = false;
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = "继续";
        }
      }
    });

    renderCheckout();
  }
</script>

<style>
  .shop {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0.35rem 1.5rem 9rem;
  }

  .empty {
    margin: 0;
    padding: 2rem;
    border: 1px dashed var(--border);
    border-radius: 1rem;
    color: var(--muted-foreground);
    background: var(--surface);
  }

  .family-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .family-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    padding: 0.95rem 1rem 1rem;
    border: 1.5px solid transparent;
    border-radius: 1rem;
    background: var(--card);
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      box-shadow 0.15s ease;
  }

  .family-card:hover {
    background: #e3e7ed;
  }

  .family-card.selected {
    border-color: #2a2e33;
    background: #e4e8ee;
    box-shadow: 0 0 0 1px rgba(42, 46, 51, 0.08);
  }

  .family-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0.35rem;
    color: var(--foreground);
  }

  .family-vendor {
    font-size: 0.78rem;
    color: var(--muted-foreground);
  }

  .family-name {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .family-price {
    margin-top: 0.55rem;
    font-size: 0.82rem;
    color: var(--muted-foreground);
  }

  .family-price strong {
    color: var(--foreground);
    font-weight: 700;
  }

  .checkout-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    padding: 0.55rem 0.85rem calc(0.55rem + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--surface) 96%, transparent);
    border-top: 1px solid var(--border);
    backdrop-filter: blur(14px);
    box-shadow: 0 -8px 30px rgba(15, 23, 42, 0.06);
  }

  .checkout-bar[hidden] {
    display: none;
  }

  .checkout-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, 0.85fr);
    gap: 0.55rem 1rem;
    align-items: center;
  }

  .checkout-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .checkout-hint {
    margin: 0.1rem 0 0.4rem;
    font-size: 0.72rem;
    color: var(--muted-foreground);
  }

  .plan-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  :global(.plan-pill) {
    height: 1.75rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--foreground);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }

  :global(.plan-pill.active) {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--primary-foreground);
  }

  .checkout-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.45rem;
    align-items: center;
  }

  .checkout-form input[type="email"] {
    height: 2.4rem;
    padding: 0 0.85rem;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    background: var(--surface);
    color: var(--foreground);
    outline: none;
  }

  .checkout-form input[type="email"]:focus {
    border-color: color-mix(in srgb, var(--primary) 45%, var(--border));
    box-shadow: 0 0 0 3px rgba(42, 46, 51, 0.08);
  }

  .checkout-submit {
    height: 2.4rem;
    min-width: 4.75rem;
    padding: 0 1.1rem;
    border-radius: 0.7rem;
  }

  .checkout-error {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.78rem;
    color: #b42318;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .family-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .checkout-inner {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }

  @media (max-width: 520px) {
    .shop {
      padding-inline: 1rem;
      padding-bottom: 9.5rem;
    }

    .family-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.55rem;
    }

    .checkout-form {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .checkout-hint {
      display: none;
    }
  }
</style>
