---
const brand = import.meta.env.PUBLIC_BRAND_NAME || "Magfield";
---

<header class="site-header" data-testid="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${brand} home`} data-testid="nav-home">
      <span class="brand-text">{brand}</span>
      <svg class="brand-mark" viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
        <path d="M6.2 3.8a7 7 0 0 0 0 12.4M13.8 3.8a7 7 0 0 1 0 12.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <circle cx="10" cy="10" r="2.2" fill="var(--magnetic)" />
      </svg>
    </a>
    <nav class="nav" aria-label="主导航">
      <a href="/#subscribe" data-testid="nav-products">订阅方案</a>
      <a href="/orders" data-testid="nav-orders">历史订单</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--background) 88%, transparent);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.42rem;
    white-space: nowrap;
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1;
    color: var(--foreground);
    text-decoration: none;
  }

  .brand-text {
    display: inline-block;
  }

  .brand-mark {
    display: inline-block;
    flex-shrink: 0;
    color: var(--foreground);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav a:hover {
    color: var(--foreground);
  }

  @media (max-width: 520px) {
    .header-inner {
      padding-inline: 1rem;
    }
    .nav {
      gap: 1.15rem;
    }
  }
</style>
