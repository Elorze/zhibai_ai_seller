---
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <h1 id="hero-heading">全球 AI 订阅，卡密与成品号即买即取</h1>
    <p>
      无需注册。选套餐、设查单密码、付 USDT，付款页与历史订单取货。
    </p>
  </div>
  <div class="hero-art" aria-hidden="true">
    <svg viewBox="0 0 320 220" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse
        cx="168"
        cy="112"
        rx="118"
        ry="78"
        stroke="currentColor"
        stroke-width="1.25"
        opacity="0.55"
      />
      <ellipse
        cx="148"
        cy="118"
        rx="96"
        ry="64"
        stroke="currentColor"
        stroke-width="1.25"
        opacity="0.4"
        transform="rotate(-18 148 118)"
      />
      <ellipse
        cx="176"
        cy="104"
        rx="72"
        ry="48"
        stroke="currentColor"
        stroke-width="1.25"
        opacity="0.7"
        transform="rotate(22 176 104)"
      />
      <circle cx="168" cy="112" r="6" fill="currentColor" opacity="0.35" />
    </svg>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 1.5rem;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem 1rem;
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.85rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: var(--foreground);
  }

  .hero-copy p {
    margin: 0.85rem 0 0;
    max-width: 28rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  .hero-art {
    display: flex;
    justify-content: center;
    color: #9aa3af;
  }

  .hero-art svg {
    width: min(100%, 280px);
    height: auto;
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 0.75rem 1rem 0.5rem;
      gap: 0.35rem;
    }

    .hero-art {
      order: -1;
      justify-content: flex-end;
      opacity: 0.65;
    }

    .hero-art svg {
      width: min(42%, 150px);
    }

    .hero-copy p {
      margin-top: 0.65rem;
      font-size: 0.9rem;
    }
  }
</style>
