---
import PageLayout from "../layouts/PageLayout.astro";

export const prerender = false;
Astro.response.status = 404;
---

<PageLayout title="页面不存在 · Magfield">
  <section class="nf" data-testid="not-found">
    <p class="code">404</p>
    <h1>页面不存在</h1>
    <p class="lead">链接可能已失效，或该商品未上架。</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">回首页</a>
      <a class="btn btn-ghost" href="/#subscribe">订阅</a>
      <a class="btn btn-ghost" href="/orders">订单查询</a>
    </div>
  </section>
</PageLayout>

<style>
  .nf {
    max-width: 28rem;
    padding-top: 2rem;
  }

  .code {
    margin: 0;
    color: var(--primary);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0.5rem 0 0;
    font-size: 2rem;
  }

  .lead {
    margin-top: 0.75rem;
    color: var(--muted-foreground);
  }

  .actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
